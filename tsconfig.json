{
  "compilerOptions": {
    //"rootDir": "./src",
    "module": "commonjs",
    "target": "esnext",
    "types": [],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "moduleDetection": "force"
  }
}
